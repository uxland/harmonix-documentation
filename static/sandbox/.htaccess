# The Sandbox page embeds StackBlitz projects that run Node in the browser (WebContainers).
# StackBlitz only starts them when the embedding page is cross-origin isolated, so this folder,
# and only this folder, is served with COOP and COEP. `credentialless` lets the page keep loading
# cross-origin resources that do not send CORP headers.
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "credentialless"
</IfModule>
